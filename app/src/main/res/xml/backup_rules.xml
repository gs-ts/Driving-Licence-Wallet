<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 (API 30) and lower; Android 12+ uses data_extraction_rules.xml.
   allowBackup="false" already disables backup, but exclude all app data anyway, so nothing
   leaks if backup is ever turned on. "root" covers files, databases and shared preferences.
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>
