<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup rules. allowBackup="false" disables backup, but some devices
   still do device-to-device transfers, so exclude all app data from both.
   "root" covers files, databases and shared preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
